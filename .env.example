# Copy to .env and fill in. Never commit .env.
ENV=dev
LOG_LEVEL=INFO

# Database (Neon or local Postgres 18). channel_binding is stripped automatically.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_STATEMENT_TIMEOUT_MS=3000
DB_MAX_INACTIVE_CONN_SECONDS=60

# REST API: clients send this in the X-API-Key header
API_KEY=

# Vapi
VAPI_API_KEY=            # private key; used only by scripts/sync_assistant.py
VAPI_PUBLIC_KEY=         # web SDK only
VAPI_PHONE_NUMBER_ID=
VAPI_PHONE_NUMBER=
VAPI_WEBHOOK_SECRET=     # shared secret Vapi sends on every webhook
PUBLIC_BASE_URL=         # Render URL in prod, ngrok domain in dev

# Clinic / agent
CLINIC_NAME="Riverside Family Clinic"
AGENT_NAME=Ava
CLINIC_TZ=America/New_York
TOOL_TIMEOUT_SECONDS=4

# Dashboard (bonus)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# Eval harness only (OpenAI-compatible endpoint, e.g. Gemini)
EVAL_LLM_API_KEY=
EVAL_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EVAL_LLM_MODEL=gemini-2.5-flash
